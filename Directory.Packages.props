<Project>
  <PropertyGroup>
    <!-- Central Package Management: every PackageReference across the solution takes its version
         from a <PackageVersion> item below. The individual .csproj files carry no Version
         attribute; a project that must deviate uses VersionOverride on its PackageReference. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Deliberately OFF. This repo ships dedicated NuGet packages, so transitive pinning is the
         wrong default here: it would hoist transitive dependencies into each package's declared
         dependency list and change what downstream consumers restore. Every shipped package must
         advertise only its own direct dependencies, so pinning stays disabled. -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- ==========================================================================================
       Shipped-package dependencies (src/**). These versions become the minimum dependency
       versions declared in each produced .nupkg, so treat bumps here as a public-contract change.
       ========================================================================================== -->
  <!-- Core runtime abstractions (Microsoft.Extensions.*), aligned to the net10.0 line. -->
  <ItemGroup>
    <!-- Shipped through AsyncResponse.Testing (its harness hosts a real container), so a bump
         here changes that package's declared minimum — not a samples/benchmarks-only version. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
  </ItemGroup>
  <!-- Channel / transport provider clients. -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.8" />
    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
    <PackageVersion Include="Confluent.Kafka" Version="2.15.0" />
    <PackageVersion Include="Google.Cloud.PubSub.V1" Version="3.36.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageVersion Include="MongoDB.Driver" Version="3.11.0" />
    <PackageVersion Include="NATS.Net" Version="3.1.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageVersion Include="StackExchange.Redis" Version="3.1.13" />
  </ItemGroup>
  <!-- Durable-flow state-store clients. -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.DynamoDBv2" Version="4.0.103.1" />
    <PackageVersion Include="Microsoft.Azure.Cosmos" Version="3.62.1" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Explicit native-lib pin overriding the older e_sqlite3 that Microsoft.Data.Sqlite bundles.
         Bump in step with Microsoft.Data.Sqlite above, matching the provider major/minor its
         SQLitePCLRaw bundle expects. Referenced by AsyncResponse.DurableFlows.Sqlite and the tests. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="MySqlConnector" Version="2.6.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
  </ItemGroup>
  <!-- Build-time only (analyzers + SourceLink), referenced with PrivateAssets="All" so they never
       become package dependencies of the shipped libraries. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />
  </ItemGroup>
  <!-- ==========================================================================================
       Samples, AppHosts and benchmarks (IsPackable=false: never shipped).
       ========================================================================================== -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Kafka" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.4.6" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Capped at the 2.x line by ASP.NET Core, NOT by choice: Microsoft.AspNetCore.OpenApi 10.0.11
         declares Microsoft.OpenApi [2.7.5, 3.0.0) — an exclusive upper bound. Microsoft.OpenApi 3.x
         is therefore unreachable until ASP.NET Core itself moves to it (expected with the 11.x
         line): pinning 3.x resolves outside the declared range (NU1608) and binds the sample
         against a type surface ASP.NET Core was not compiled against. 2.12.0 is the newest release
         inside the range. That range floor also clears the high-severity advisory (NU1903,
         GHSA-v5pm-xwqc-g5wc) that affected 2.x below 2.7.5, which is why the floor sits there.
         Re-check the upper bound whenever Microsoft.AspNetCore.OpenApi is bumped.
         The direct reference that carries this pin lives in AsyncResponse.Sample. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="3.10.2" />
    <PackageVersion Include="NBomber" Version="4.1.2" />
    <PackageVersion Include="NBomber.Http" Version="4.1.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>
  <!-- ==========================================================================================
       Test tooling (tests/**). xUnit.net v3 ships parallel `mtp-v1`/`mtp-v2` build variants; the
       `mtp-v2` one is built against Microsoft.Testing.Platform v2, so the platform host and its
       TrxReport extension are pinned together on the 2.x line to keep the shared testing-host
       assembly compatible — a major mismatch fails at startup with a TypeLoadException on
       IDataConsumer. xunit.v3.mtp-v2 4.0.0 depends on MTP >= 2.3.3, which is what is pinned here,
       so the 3.2.x -> 4.0.0 bump stays inside the same MTP major.
       Microsoft.Testing.Extensions.CodeCoverage tracks its own 18.x cadence, independent of that lock.
       ========================================================================================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.3.3" />
    <PackageVersion Include="Microsoft.Testing.Platform" Version="2.3.3" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.0" />
  </ItemGroup>
  <!-- ==========================================================================================
       EF Core majors track the target runtime: LTS 8.x for net8.0 consumers (so an EF8 app is
       never force-upgraded) and 10.x for net10.0. NuGet evaluates these conditions per target
       framework during restore, mirroring the conditioned PackageReference ItemGroups in
       AsyncResponse.DurableFlows.EFCore (Relational) and AsyncResponse.Tests (Sqlite, SqlServer).
       SqlServer is conditioned for the same reason: the matrix harness maps its EF Core cells onto
       SQL Server, and that shared source compiles into the multi-targeted unit-test project too.
       ========================================================================================== -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.30" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.30" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
  </ItemGroup>
</Project>