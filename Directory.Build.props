<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Audit direct AND transitive dependencies against the NuGet vulnerability database on every
         restore (NU1901-1904). -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- Warnings are errors in CI so the bar can't regress; local builds stay warning-tolerant for
         work-in-progress. NuGet-audit advisories (NU19xx) are deliberately excluded: a newly
         disclosed CVE in a dependency should surface and be handled (via Dependabot), not break
         every unrelated PR's build. -->
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <PackageIcon>icon.png</PackageIcon>

    <!-- Strong-name every assembly (Microsoft's OSS library guidance): strongly-named consumers
         can reference the packages, and InternalsVisibleTo carries the matching public key. The
         checked-in key is intentionally public — strong naming is identity, not a security
         boundary. Signing must never be conditional: a signed/unsigned split would change
         assembly identity between builds. -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)asyncresponse.snk</AssemblyOriginatorKeyFile>
    <AsyncResponsePublicKey></AsyncResponsePublicKey>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
