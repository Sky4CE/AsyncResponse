<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NBomber is not strong-named (CS8002); this harness needs no assembly identity
         and no InternalsVisibleTo, so it opts out of the repo-wide signing. -->
    <SignAssembly>false</SignAssembly>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- NBomber drives the HTTP load; Aspire.Hosting.Testing boots the real Redis + broker-backed
         sample SUTs, reusing the integration AppHost. -->
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="NBomber" />
    <PackageReference Include="NBomber.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tests\AsyncResponse.IntegrationTests.AppHost\AsyncResponse.IntegrationTests.AppHost.csproj" />
  </ItemGroup>

</Project>
