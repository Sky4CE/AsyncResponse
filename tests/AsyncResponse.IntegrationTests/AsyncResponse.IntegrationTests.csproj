<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- Microsoft.Testing.Platform host (xUnit.net v3), matching the unit-test project. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Platform" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />

    <!-- Boots the Aspire AppHost (real Redis + Pub/Sub emulator containers + the SUT) in-process. -->
    <PackageReference Include="Aspire.Hosting.Testing" />
    <!-- EF Core provider for the EFCore durable-flow store test against the containerized SQL Server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <!-- In-process WebApplicationFactory hosting for the no-Docker in-memory end-to-end tests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <!-- Channel-contract conformance suite shared with AsyncResponse.Tests (mirrors the
       src/Channels/Shared pattern): the abstract suite lives once, each project derives it for the
       channels it can reach (the container-backed channels here; in-memory over there). -->
  <ItemGroup>
    <Compile Include="..\Shared\ChannelConformanceSuite.cs" Link="Shared\ChannelConformanceSuite.cs" />
  </ItemGroup>

  <!-- The provider cross product (channel x transport x durable-flow store). ProviderMatrix.cs
       enumerates the combinations and partitions them into container-footprint shards; MatrixHarness.cs
       wires and runs one combination. Shared source rather than test-project source because the
       unit-test project derives the same suites for the in-memory combination. -->
  <ItemGroup>
    <Compile Include="..\Shared\ProviderMatrix.cs" Link="Shared\ProviderMatrix.cs" />
    <Compile Include="..\Shared\MatrixHarness.cs" Link="Shared\MatrixHarness.cs" />
    <Compile Include="..\Shared\MatrixScenarios.cs" Link="Shared\MatrixScenarios.cs" />
    <Compile Include="..\Shared\TransportCapabilities.cs" Link="Shared\TransportCapabilities.cs" />
    <Compile Include="..\Shared\TransportConformanceSuite.cs" Link="Shared\TransportConformanceSuite.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AppHost orchestrates the SUT (Projects.AsyncResponse_IntegrationTests_AppHost). The sample app *is* the
         SUT: it provides the shared DTO types (OperationResult / OperationStatus / FlowCall) and its Program entry
         point for the in-process WebApplicationFactory tests. -->
    <ProjectReference Include="..\AsyncResponse.IntegrationTests.AppHost\AsyncResponse.IntegrationTests.AppHost.csproj" />
    <ProjectReference Include="..\..\samples\AsyncResponse.Sample\AsyncResponse.Sample.csproj" />
    <!-- The abrupt-crash suite's subprocess (DurableFlowAbruptCrashRecoveryTests). Referenced for the
         build order and for CrashWorkerContract (env vars, crash points, table names), which the tests
         share with it. The suite does NOT launch the copy this reference drops next to the test
         assembly — see EmbedCrashWorkerPath below. -->
    <ProjectReference Include="..\AsyncResponse.IntegrationTests.CrashWorker\AsyncResponse.IntegrationTests.CrashWorker.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.MongoDB\AsyncResponse.Channels.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.NATS\AsyncResponse.Channels.NATS.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.PostgreSQL\AsyncResponse.Channels.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.Redis\AsyncResponse.Channels.Redis.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.SqlServer\AsyncResponse.Channels.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.Cosmos\AsyncResponse.DurableFlows.Cosmos.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.DynamoDB\AsyncResponse.DurableFlows.DynamoDB.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.EFCore\AsyncResponse.DurableFlows.EFCore.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.MongoDB\AsyncResponse.DurableFlows.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.MySql\AsyncResponse.DurableFlows.MySql.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.Oracle\AsyncResponse.DurableFlows.Oracle.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.PostgreSQL\AsyncResponse.DurableFlows.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.SqlServer\AsyncResponse.DurableFlows.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.Sqlite\AsyncResponse.DurableFlows.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.AzureServiceBus\AsyncResponse.Transports.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.GooglePubSub\AsyncResponse.Transports.GooglePubSub.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.Kafka\AsyncResponse.Transports.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.MongoDB\AsyncResponse.Transports.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.NATS\AsyncResponse.Transports.NATS.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.PostgreSQL\AsyncResponse.Transports.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.RabbitMQ\AsyncResponse.Transports.RabbitMQ.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.Redis\AsyncResponse.Transports.Redis.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.SQS\AsyncResponse.Transports.SQS.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.SqlServer\AsyncResponse.Transports.SqlServer.csproj" />
  </ItemGroup>

  <!-- The crash worker is launched from ITS OWN output directory, whose path is stamped into this
       assembly here. The copy the ProjectReference places next to the test assembly is not
       runnable in general: this project references ASP.NET Core, so MSBuild's conflict resolution
       drops any package assembly the shared framework also ships at an equal or higher version
       (Microsoft.Extensions.Hosting.Abstractions, ...) from THIS output — while the worker's
       runtimeconfig.json lists Microsoft.NETCore.App only. Whether the file survives depends on
       the SDK: with SDK 10.0.101 (framework 10.0.1 < package 10.0.12) the package wins and the copy
       runs; with SDK 10.0.401 (framework 10.0.12) the framework wins and the subprocess dies at
       startup with FileNotFoundException, which is how round 40's suite failed on CI only. The
       worker's own output has no such conflict and is self-consistent on every SDK. GetTargetPath
       returns the exact path for the current Configuration/layout, so nothing is guessed. -->
  <Target Name="EmbedCrashWorkerPath" BeforeTargets="GetAssemblyAttributes">
    <MSBuild Projects="..\AsyncResponse.IntegrationTests.CrashWorker\AsyncResponse.IntegrationTests.CrashWorker.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="CrashWorkerTargetPath" />
    </MSBuild>
    <ItemGroup>
      <AssemblyMetadata Include="AsyncResponse.CrashWorkerPath" Value="$(CrashWorkerTargetPath)" />
    </ItemGroup>
  </Target>

</Project>
