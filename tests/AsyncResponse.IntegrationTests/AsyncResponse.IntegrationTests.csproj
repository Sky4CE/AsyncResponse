<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- Microsoft.Testing.Platform host (xUnit.net v3), matching the unit-test project. -->
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Testing.Platform" Version="2.2.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.2.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.8.0" />

    <!-- Boots the Aspire AppHost (real Redis + Pub/Sub emulator containers + the SUT) in-process. -->
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.4.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The AppHost provides the orchestration (Projects.AsyncResponse_AppHost); the App provides the
         shared DTO types (ItestPayload / ItestStatus / ItestCall) used to deserialize HTTP responses. -->
    <ProjectReference Include="..\..\samples\AsyncResponse.AppHost\AsyncResponse.AppHost.csproj" />
    <ProjectReference Include="..\AsyncResponse.IntegrationTests.App\AsyncResponse.IntegrationTests.App.csproj" />
  </ItemGroup>

</Project>
