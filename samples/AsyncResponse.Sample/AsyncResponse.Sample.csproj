<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>

    <!-- The sample is the integration-test SUT and doubles as the Native AOT proof for the whole
         provider matrix: CI publishes it fully trimmed and runs the integration suite against the
         native binary (see docs/aot.md). The Roslyn trim/AOT analyzers keep the app's own code
         warning-free on every build; IL2104/IL3053 are publish-time rollup warnings from vendor
         broker SDKs that ship without trim annotations (expected, tracked in docs/aot.md). -->
    <PublishAot>true</PublishAot>
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncResponse.ServiceDefaults\AsyncResponse.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\AsyncResponse.Core\AsyncResponse.Core.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.MongoDB\AsyncResponse.Channels.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.NATS\AsyncResponse.Channels.NATS.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.PostgreSQL\AsyncResponse.Channels.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.Redis\AsyncResponse.Channels.Redis.csproj" />
    <ProjectReference Include="..\..\src\Channels\AsyncResponse.Channels.SqlServer\AsyncResponse.Channels.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.MongoDB\AsyncResponse.DurableFlows.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\DurableFlows\AsyncResponse.DurableFlows.Sqlite\AsyncResponse.DurableFlows.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.AzureServiceBus\AsyncResponse.Transports.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.GooglePubSub\AsyncResponse.Transports.GooglePubSub.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.Kafka\AsyncResponse.Transports.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.MongoDB\AsyncResponse.Transports.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.NATS\AsyncResponse.Transports.NATS.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.PostgreSQL\AsyncResponse.Transports.PostgreSQL.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.RabbitMQ\AsyncResponse.Transports.RabbitMQ.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.Redis\AsyncResponse.Transports.Redis.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.SqlServer\AsyncResponse.Transports.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Transports\AsyncResponse.Transports.SQS\AsyncResponse.Transports.SQS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\AsyncResponse.Core\Logging\AsyncResponseLoggerExtensions.cs" Link="Logging\AsyncResponseLoggerExtensions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Direct pin overriding the vulnerable Microsoft.OpenApi that Microsoft.AspNetCore.OpenApi
         pulls transitively. The version floor and CVE detail live in Directory.Packages.props. -->
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

</Project>
