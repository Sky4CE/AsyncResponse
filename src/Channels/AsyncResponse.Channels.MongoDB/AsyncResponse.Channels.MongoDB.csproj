<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Channels.MongoDB</PackageId>
    <Description>MongoDB channel for AsyncResponse: change-stream response wakeups and durable TTL-indexed recovery-state collections for lost-subscriber recovery across redeploys, with domain-state-aware failure routing. Requires a replica set (change streams). Plugs into the Core engine's recovery watchdog and readiness health check.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Sample" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
    <!-- Moq proxies over IMongoCollection<internal document type> in the unit tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
  </ItemGroup>

</Project>
