<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Channels.PostgreSQL</PackageId>
    <Description>PostgreSQL channel for AsyncResponse: LISTEN/NOTIFY response wakeups and durable PostgreSQL recovery-state tables for lost-subscriber recovery across redeploys, with domain-state-aware failure routing. Plugs into the Core engine's recovery watchdog and readiness health check.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Sample" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

</Project>
