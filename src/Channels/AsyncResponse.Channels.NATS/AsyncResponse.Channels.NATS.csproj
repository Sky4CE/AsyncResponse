<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- JSON goes through Core's source-generated metadata seam (AsyncResponseJson /
         AsyncResponseEnvelopeJson); no reflection-based serialization remains. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>AsyncResponse.Channels.NATS</PackageId>
    <Description>NATS channel for AsyncResponse: a NATS Core request/reply response channel and a durable NATS JetStream Key-Value recovery-state store for lost-subscriber recovery across redeploys, with domain-state-aware failure routing. Plugs into the Core engine's recovery watchdog and readiness health check.</Description>
    <PackageTags>$(PackageTags);nats;jetstream</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="NATS.Net" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project white-box the internal subject schema and adapters without widening the public API. -->
    <InternalsVisibleTo Include="AsyncResponse.Tests" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" Key="$(AsyncResponsePublicKey)" />
    <!-- Lets Moq's DynamicProxy mock the internal adapter interfaces in unit tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
  </ItemGroup>

</Project>
