<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Channels.Redis</PackageId>
    <Description>Redis channel for AsyncResponse: Redis pub/sub response channel and durable Redis recovery-state store for lost-subscriber recovery across redeploys, with domain-state-aware failure routing. Plugs into the Core engine's recovery watchdog and readiness health check.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project white-box the internal key schema without widening the public API. -->
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
  </ItemGroup>

</Project>
