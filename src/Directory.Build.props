<Project>

  <!-- Inherit the repo-root properties. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared NuGet packaging metadata for all shipped packages. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Version>0.1.0</Version>
    <Authors>Vitalii Tiunisov</Authors>
    <Company>Vitalii Tiunisov</Company>
    <Copyright>Copyright (c) Vitalii Tiunisov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Sky4CE/AsyncResponse</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sky4CE/AsyncResponse</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Ecosystem-wide tags only. Each provider package appends its own terms in its csproj via
         <PackageTags>$(PackageTags);...</PackageTags>. -->
    <PackageTags>async;response;correlation;correlation-id;channel;transport;request-response;messaging;background-worker;recovery;resilience</PackageTags>
    <!-- Package-facing readme with absolute links only; the repo README's relative links would
         break on nuget.org. -->
    <PackageReadmeFile>nuget-readme.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML-doc warnings on every public member would drown the build; docs are still generated. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Deterministic builds + SourceLink for debuggable public packages. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Validate the packed public API surface is consistent across target frameworks.
         PackageValidationBaselineVersion MUST be set to 0.1.0 immediately after the first stable
         release ships, or binary-compat breaks go undetected. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../docs/nuget-readme.md" Pack="true" PackagePath="\" Visible="false" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />

    <!-- Track the public API surface: RS0016/RS0017 flag any public member that is not recorded in
         the per-project PublicAPI.{Shipped,Unshipped}.txt files, so surface changes are explicit in
         review. Analyzer-only (PrivateAssets="All"); never a package dependency. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
