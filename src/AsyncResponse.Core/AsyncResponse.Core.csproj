<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Core</PackageId>
    <Description>Core AsyncResponse implementation: fluent registration and waiter builder, process-local response channel and recovery store, transport-neutral ingress, payload outcome classification, lost-subscriber callback dispatch, expression-based callbacks, an in-memory worker queue, and the recovery watchdog plus readiness health check.</Description>

    <!-- All internal serialization uses source-generated metadata (AsyncResponseJsonContext);
         user payload types resolve through the AsyncResponseJsonSerialization seam. The inherently
         dynamic surface (persisted reflection callbacks, reflective flow fallback) is annotated
         RequiresUnreferencedCode / DynamicallyAccessedMembers, with fail-closed guarded internals. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Channels.MongoDB" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.NATS" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.PostgreSQL" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.Redis" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.SqlServer" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.AzureServiceBus" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.GooglePubSub" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.Kafka" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.MongoDB" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.NATS" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.PostgreSQL" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.RabbitMQ" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.SqlServer" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.SQS" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.Redis" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Tests" Key="$(AsyncResponsePublicKey)" />
    <!-- Moq/Castle proxies of internal seams (test doubles for vendor-client adapters); the
         well-known DynamicProxyGenAssembly2 identity is required once assemblies are signed. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" Key="$(AsyncResponsePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncResponse.Abstractions\AsyncResponse.Abstractions.csproj" />
  </ItemGroup>

</Project>
