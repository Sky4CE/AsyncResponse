<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Core</PackageId>
    <Description>Transport-agnostic core of AsyncResponse: the fluent waiter builder (Until/WithTimeout/TriggeredBy), payload outcome classification, lost-subscriber callback dispatch, expression-based callback registration, and an in-process worker transport for development and single-node deployments.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Redis" />
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncResponse.Abstractions\AsyncResponse.Abstractions.csproj" />
  </ItemGroup>

</Project>
