<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Core</PackageId>
    <Description>Core AsyncResponse implementation: fluent registration and waiter builder, process-local response channel and recovery store, transport-neutral ingress, payload outcome classification, lost-subscriber callback dispatch, expression-based callbacks, an in-memory worker queue, and the recovery watchdog plus readiness health check.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Channels.NATS" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.PostgreSQL" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.Redis" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.AzureServiceBus" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.GooglePubSub" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.NATS" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.PostgreSQL" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.RabbitMQ" />
    <InternalsVisibleTo Include="AsyncResponse.Transports.Redis" />
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncResponse.Abstractions\AsyncResponse.Abstractions.csproj" />
  </ItemGroup>

</Project>
