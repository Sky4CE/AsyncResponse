<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- JSON goes through Core's source-generated metadata seam (AsyncResponseJson /
         AsyncResponseEnvelopeJson); no reflection-based serialization remains. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>AsyncResponse.Transports.SqlServer</PackageId>
    <Description>Microsoft SQL Server transport for AsyncResponse: publish worker jobs to durable SQL Server queue tables, consume worker-job and response-ingress queues claimed with UPDLOCK/READPAST, with bounded redelivery and dead-lettering, and expose SQL Server reply targets.</Description>
    <PackageTags>$(PackageTags);sqlserver;mssql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" Key="$(AsyncResponsePublicKey)" />
    <!-- Moq/Castle proxies of internal seams (test doubles for vendor-client adapters); the
         well-known DynamicProxyGenAssembly2 identity is required once assemblies are signed. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Sample" Key="$(AsyncResponsePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DbTransportShared.cs" Link="DbTransportShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
