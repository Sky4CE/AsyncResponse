<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Transports.AzureServiceBus</PackageId>
    <Description>Azure Service Bus transport for AsyncResponse: publish worker jobs to Service Bus queues, consume worker-job queues, and feed response queues into the transport-neutral AsyncResponse ingress.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.2" />
  </ItemGroup>

</Project>
