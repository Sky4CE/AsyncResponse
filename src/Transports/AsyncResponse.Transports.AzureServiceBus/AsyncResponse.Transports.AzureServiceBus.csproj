<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- JSON goes through Core's source-generated metadata seam (AsyncResponseJson /
         AsyncResponseEnvelopeJson); no reflection-based serialization remains. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>AsyncResponse.Transports.AzureServiceBus</PackageId>
    <Description>Azure Service Bus transport for AsyncResponse: publish worker jobs to Service Bus queues, consume worker-job queues, and feed response queues into the transport-neutral AsyncResponse ingress.</Description>
    <PackageTags>$(PackageTags);azure;servicebus</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" Key="$(AsyncResponsePublicKey)" />
    <!-- Moq/Castle proxies of internal seams (test doubles for vendor-client adapters); the
         well-known DynamicProxyGenAssembly2 identity is required once assemblies are signed. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" Key="$(AsyncResponsePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\CorrelationIdJsonPaths.cs" Link="CorrelationIdJsonPaths.cs" />
    <Compile Include="..\Shared\SubscriberSupervisor.cs" Link="SubscriberSupervisor.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" />
  </ItemGroup>

</Project>
