<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Transports.NATS</PackageId>
    <Description>NATS JetStream transport for AsyncResponse: publish worker jobs to JetStream subjects, consume worker-job subjects, and feed response subjects into the transport-neutral AsyncResponse ingress with explicit acknowledgement, bounded redelivery, and dead-lettering.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
    <!-- Lets Moq's DynamicProxy mock the internal adapter interfaces in unit tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="NATS.Net" Version="3.0.0" />
  </ItemGroup>

</Project>
