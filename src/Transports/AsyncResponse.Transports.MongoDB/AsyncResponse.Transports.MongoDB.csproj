<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- JSON goes through Core's source-generated metadata seam (AsyncResponseJson /
         AsyncResponseEnvelopeJson); no reflection-based serialization remains. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>AsyncResponse.Transports.MongoDB</PackageId>
    <Description>MongoDB transport for AsyncResponse: publish worker jobs to durable MongoDB queue collections, consume worker-job and response-ingress queues with atomic findOneAndUpdate claims, bounded redelivery and dead-lettering, and expose MongoDB reply targets.</Description>
    <PackageTags>$(PackageTags);mongodb</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Sample" Key="$(AsyncResponsePublicKey)" />
    <!-- Moq proxies over IMongoCollection<internal document type> in the unit tests. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

</Project>
