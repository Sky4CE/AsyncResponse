<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.DurableFlows.DynamoDB</PackageId>
    <Description>Amazon DynamoDB durable-flow state store for AsyncResponse. Persists durable-flow ledgers in an application-owned DynamoDB table instead of the response-channel recovery cache.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AsyncResponse.DurableFlows.Shared\DurableFlowStoreShared.cs" Link="DurableFlowStoreShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="4.0.101.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
  </ItemGroup>

</Project>
