<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.DurableFlows.MongoDB</PackageId>
    <Description>MongoDB durable-flow state store for AsyncResponse. Persists durable-flow ledgers in an application-owned MongoDB collection instead of the response-channel recovery cache.</Description>
    <!-- FlowState (the only JSON this package writes) goes through Core's FlowStateJson
         (source-generated metadata + the AsyncResponseJsonSerialization resolver seam); no
         reflection-based serialization remains. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageTags>$(PackageTags);mongodb;durable;workflow;orchestration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DurableFlowStoreShared.cs" Link="DurableFlowStoreShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" Key="$(AsyncResponsePublicKey)" />
    <!-- Moq/Castle proxies of internal seams (test doubles for vendor-client adapters); the
         well-known DynamicProxyGenAssembly2 identity is required once assemblies are signed. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" Key="$(AsyncResponsePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Shared\MongoOwnershipLedger.cs" Link="MongoOwnershipLedger.cs" />
    <Compile Include="..\..\Shared\MongoNamespaceRegistry.cs" Link="MongoNamespaceRegistry.cs" />
  </ItemGroup>

</Project>
