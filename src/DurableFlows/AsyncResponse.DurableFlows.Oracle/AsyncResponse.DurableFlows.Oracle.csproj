<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.DurableFlows.Oracle</PackageId>
    <Description>Oracle Database durable-flow state store for AsyncResponse. Persists durable-flow ledgers in an application-owned Oracle table instead of the response-channel recovery cache.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DurableFlowStoreShared.cs" Link="DurableFlowStoreShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
  </ItemGroup>

</Project>
