<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.DurableFlows.EFCore</PackageId>
    <Description>Entity Framework Core durable-flow state store for AsyncResponse. Maps the durable-flow ledger into an application-owned DbContext so any EF Core relational provider can host it and the table rides the application's own migration pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DurableFlowStoreShared.cs" Link="DurableFlowStoreShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
  </ItemGroup>

  <!-- EF Core majors track the runtime: LTS 8.x for net8.0 consumers (so an EF8 app is not
       force-upgraded), 10.x for net10.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.7" />
  </ItemGroup>

</Project>
