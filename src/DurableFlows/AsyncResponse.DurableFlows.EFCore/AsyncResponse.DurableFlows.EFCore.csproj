<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.DurableFlows.EFCore</PackageId>
    <Description>Entity Framework Core durable-flow state store for AsyncResponse. Maps the durable-flow ledger into an application-owned DbContext so any EF Core relational provider can host it and the table rides the application's own migration pipeline.</Description>
    <!-- FlowState (the only JSON this package writes) goes through Core's FlowStateJson
         (source-generated metadata + the AsyncResponseJsonSerialization resolver seam); no
         reflection-based serialization remains. -->
    <IsAotCompatible>true</IsAotCompatible>
    <PackageTags>$(PackageTags);efcore;entityframework;durable;workflow;orchestration</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DurableFlowStoreShared.cs" Link="DurableFlowStoreShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" Key="$(AsyncResponsePublicKey)" />
    <!-- Moq/Castle proxies of internal seams (test doubles for vendor-client adapters); the
         well-known DynamicProxyGenAssembly2 identity is required once assemblies are signed. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" Key="$(AsyncResponsePublicKey)" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" Key="$(AsyncResponsePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- EF Core majors track the runtime: LTS 8.x for net8.0 consumers (so an EF8 app is not
         force-upgraded), 10.x for net10.0. The per-runtime version is selected by the conditioned
         PackageVersion items in Directory.Packages.props, so this reference stays version-less. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
