<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.DurableFlows.Sqlite</PackageId>
    <Description>SQLite durable-flow state store for AsyncResponse. Persists durable-flow ledgers in an application-owned SQLite table instead of the response-channel recovery cache.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DurableFlowStoreShared.cs" Link="DurableFlowStoreShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <!-- Explicit native-lib pin: Microsoft.Data.Sqlite's bundled SQLitePCLRaw carries an older
         e_sqlite3 build; keep this version in step with the bundle's expected provider major/minor
         when bumping Microsoft.Data.Sqlite. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

</Project>
