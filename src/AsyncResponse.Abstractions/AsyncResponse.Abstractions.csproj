<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Abstractions</PackageId>
    <Description>Contracts for AsyncResponse: correlation-id based request/response over messaging, pluggable recovery-state stores, domain-outcome classification of payloads, lost-subscriber recovery callbacks, and worker dispatch. Reference this package from class libraries; hosts reference AsyncResponse.Core plus optional backend packages.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Core" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.MongoDB" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.NATS" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.PostgreSQL" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.Redis" />
    <InternalsVisibleTo Include="AsyncResponse.Channels.SqlServer" />
  </ItemGroup>

</Project>
