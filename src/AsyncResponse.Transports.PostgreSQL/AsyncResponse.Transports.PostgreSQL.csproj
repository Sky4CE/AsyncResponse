<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Transports.PostgreSQL</PackageId>
    <Description>PostgreSQL transport for AsyncResponse: publish worker jobs to durable PostgreSQL queue tables, consume worker-job and response-ingress queues with bounded redelivery and dead-lettering, and expose PostgreSQL reply targets.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
    <InternalsVisibleTo Include="AsyncResponse.Sample" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
