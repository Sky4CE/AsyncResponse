<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.Transports.Kafka</PackageId>
    <Description>Apache Kafka transport for AsyncResponse: publish worker jobs to Kafka topics, consume worker-job topics with classic consumer groups, and feed response topics into the transport-neutral AsyncResponse ingress with in-process bounded retries and dead-letter topics. Protocol-compatible with Redpanda, Amazon MSK, WarpStream, Aiven, and Confluent Cloud.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="2.15.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
  </ItemGroup>

</Project>
