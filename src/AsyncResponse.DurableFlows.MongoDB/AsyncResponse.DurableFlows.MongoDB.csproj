<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AsyncResponse.DurableFlows.MongoDB</PackageId>
    <Description>MongoDB durable-flow state store for AsyncResponse. Persists durable-flow ledgers in an application-owned MongoDB collection instead of the response-channel recovery cache.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AsyncResponse.DurableFlows.Shared\DurableFlowStoreShared.cs" Link="DurableFlowStoreShared.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AsyncResponse.Tests" />
    <InternalsVisibleTo Include="AsyncResponse.IntegrationTests" />
    <InternalsVisibleTo Include="AsyncResponse.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsyncResponse.Core\AsyncResponse.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" Version="3.10.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.9" />
  </ItemGroup>

</Project>
